# Copy this file to .env and fill in your keys. Git ignores .env; never commit it.
OPENROUTER_API_KEY=sk-or-...

# Optional: pick the OpenRouter model used by the live check
# MOOT_TEST_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Where Moot saves discussions (default: %LOCALAPPDATA%\Moot on Windows,
# ~/.local/share/moot on Linux, ~/Library/Application Support/Moot on macOS)
# MOOT_DATA_DIR=D:\Moot data

# Optional: web search for agents with the "Search the web" tool (one of these)
# TAVILY_API_KEY=tvly-...        (1,000 free searches a month)
# BRAVE_API_KEY=...
# SEARXNG_URL=http://localhost:8888
